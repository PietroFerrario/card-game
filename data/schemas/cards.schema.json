{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Card definitions (cards.json)",
    "type": "object",
    "required": [
        "cardList"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "cardList": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/card"
            }
        }
    },
    "definitions": {
        "cardTag": {
            "type": "string",
            "enum": [
                "ranged",
                "melee",
                "wiht",
                "beast",
                "clog",
                "common",
                "unique"
            ]
        },
        "card": {
            "type": "object",
            "required": [
                "id",
                "name",
                "descr",
                "population",
                "tags",
                "damage",
                "armor",
                "actions",
                "drawing",
                "effectList"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "descr": {
                    "type": "string"
                },
                "population": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                },
                "tags": {
                    "type": "array",
                    "description": "Descriptive labels for the card.",
                    "items": {
                        "$ref": "#/definitions/cardTag"
                    },
                    "uniqueItems": true
                },
                "damage": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                },
                "armor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                },
                "actions": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                },
                "drawing": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                },
                "amount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99,
                    "description": "Optional. Generic magnitude consumed by effects that need one (e.g. buffIfCardPlayed)."
                },
                "referenceId": {
                    "type": "string",
                    "description": "Optional. The id this card's effects refer to: a card id for buffIfCardPlayed, a move name for increaseDamageEnemyMove."
                },
                "upParams": {
                    "type": "string",
                    "enum": [
                        "attack",
                        "armor",
                        "action",
                        "drawing"
                    ],
                    "description": "Optional. Which stat an effect modifies. Must match upgradeCardParamMap in cardParams.h."
                },
                "cardDisposalMode": {
                    "type": "string",
                    "enum": [
                        "discard",
                        "destroy",
                        "exhaustUntilEndOfMatch"
                    ],
                    "description": "Optional. What happens to the card once played. Defaults to discard."
                },
                "effectList": {
                    "type": "array",
                    "items": {
                        "$ref": "common.schema.json#/definitions/effect"
                    }
                }
            }
        }
    }
}
