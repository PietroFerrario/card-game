{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Shared definitions for card-game data",
    "definitions": {
        "effectName": {
            "description": "Combat effect applied by a card or enemy move. Must match effectNameMap in effectName.h.",
            "enum": [
                "gainArmor",
                "gainAttack",
                "gainActions",
                "drawCards",
                "limitCardToPlay",
                "takeHostage",
                "addClogCardToDeck",
                "increaseDamageEnemyMove"
            ]
        },
        "target": {
            "description": "Who the effect hits. null = no target (drawCards / gainActions).",
            "enum": [
                "self",
                "opponent",
                null
            ]
        },
        "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "effect",
                "target"
            ],
            "properties": {
                "effect": {
                    "$ref": "#/definitions/effectName"
                },
                "target": {
                    "$ref": "#/definitions/target"
                }
            }
        }
    }
}
