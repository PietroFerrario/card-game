{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Starting decks (decks.json)",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        }
    },
    "additionalProperties": {
        "$ref": "#/definitions/deck"
    },
    "definitions": {
        "deck": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "amount"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "amount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 99
                    }
                }
            }
        }
    }
}
