{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Enemy definitions (enemies.json)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "enemyList"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "enemyList": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/enemy"
            }
        }
    },
    "definitions": {
        "enemy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "hp",
                "movesList"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "hp": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999
                },
                "movesList": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/move"
                    }
                }
            }
        },
        "move": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "moveName",
                "moveDescription",
                "damage",
                "armor",
                "effectList"
            ],
            "properties": {
                "moveName": {
                    "type": "string",
                    "minLength": 1
                },
                "moveDescription": {
                    "type": "string"
                },
                "damage": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 999
                },
                "armor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 999
                },
                "cardsLimit": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Optional. Max cards the play may play the turn this move resolve. Omit for no limit."
                },
                "effectList": {
                    "type": "array",
                    "items": {
                        "$ref": "common.schema.json#/definitions/effect"
                    }
                }
            }
        }
    }
}
