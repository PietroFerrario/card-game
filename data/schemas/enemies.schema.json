{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Enemy definitions (enemies.json)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "enemyList"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "enemyList": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/enemy"
            }
        }
    },
    "definitions": {
        "enemy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "hp",
                "movesList"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "hp": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999
                },
                "movesList": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/move"
                    }
                }
            }
        },
        "move": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "moveName",
                "moveDescription",
                "damage",
                "armor",
                "effectList"
            ],
            "properties": {
                "moveName": {
                    "type": "string",
                    "minLength": 1
                },
                "moveDescription": {
                    "type": "string"
                },
                "damage": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 999
                },
                "armor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 999
                },
                "amount": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Optional. Generic scalar interpreted by this move's effect (e.g. limitCardToPlay = max cards the player may play; addClogCardToDeck = number of clog cards to add)."
                },
                "cardId": {
                    "type": "string",
                    "description": "Optional. Card id used by effects that add a card to the deck (e.g. addClogCardToDeck → the card to insert)."
                },
                "effectList": {
                    "type": "array",
                    "items": {
                        "$ref": "common.schema.json#/definitions/effect"
                    }
                }
            }
        }
    }
}
